; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rad Proto (4.6)"
run/main_scene="uid://f7gmtnhhyupf"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://cc0l85i8nvly"

[autoload]

Database="*uid://bln0jy35ltx3v"
Signals="*uid://xtmj22r2m3ib"
AudioManager="*uid://cwux4k7eekfr4"
LevelManager="*uid://dv815lbvuqiof"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg")

[file_customization]

folder_colors={
"res://LICENSES/": "red",
"res://addons/": "gray",
"res://audio/": "orange",
"res://components/": "teal",
"res://data/": "gray",
"res://globals/": "red",
"res://levels/": "blue",
"res://menus/": "purple",
"res://themes/": "pink"
}

[gui]

theme/custom="uid://mcv1vi4lpy6n"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
